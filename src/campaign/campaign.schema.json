{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "campaign.schema.json",
  "title": "Campanha iHunt",
  "type": "object",
  "required": [
    "campaign",
    "hunters",
    "missions"
  ],
  "properties": {
    "campaign": {
      "type": "object",
      "required": [
        "name",
        "date"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "date": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "hunters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "avatar": {
            "type": "string"
          },
          "rating": {
            "type": "number",
            "minimum": 0,
            "maximum": 5
          }
        }
      }
    },
    "missions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "location",
          "value",
          "risk"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "value": {
            "type": "number",
            "minimum": 0
          },
          "risk": {
            "enum": [
              "baixo",
              "médio",
              "alto"
            ]
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "featured": {
            "type": "boolean"
          },
          "nearHunters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "hunters": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "result": {
            "enum": [
              "concluída",
              "fracassada"
            ]
          },
          "deadline": {
            "type": "string",
            "format": "date-time"
          },
          "postedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "npcs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "avatar": {
            "type": "string"
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "npc",
          "to",
          "sentAt",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "npc": {
            "type": "string"
          },
          "to": {
            "oneOf": [
              {
                "const": "all"
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "sentAt": {
            "type": "string",
            "format": "date-time"
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
