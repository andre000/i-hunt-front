{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "campaign.schema.json",
  "title": "Campanha iHunt",
  "type": "object",
  "required": ["campaign", "hunters", "missions"],
  "properties": {
    "campaign": {
      "type": "object",
      "required": ["name", "date"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "date": { "type": "string", "format": "date-time" }
      }
    },
    "hunters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 }
        }
      }
    },
    "missions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "location", "value", "risk"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "location": { "type": "string" },
          "value": { "type": "number", "minimum": 0 },
          "risk": { "enum": ["baixo", "médio", "alto"] },
          "tags": { "type": "array", "items": { "type": "string" } },
          "featured": { "type": "boolean" },
          "nearHunters": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
